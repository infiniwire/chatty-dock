{
  "name": "chatty-dock",
  "version": "0.2.1",
  "description": "An independent multi-window ChatGPT desktop workspace",
  "main": "out/main/index.js",
  "author": "infiniwire",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "electron-vite dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "node scripts/electron-test.mjs",
    "test:dev": "node scripts/dev-check.mjs",
    "test:update-install": "node scripts/update-install-test.mjs",
    "build": "electron-vite build",
    "icons": "node scripts/icons.mjs",
    "package:dir": "npm run build && node scripts/package.mjs dir",
    "package:win": "npm run build && node scripts/package.mjs win x64",
    "package:mac:x64": "npm run build && node scripts/package.mjs mac x64",
    "package:mac:arm64": "npm run build && node scripts/package.mjs mac arm64",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:electron"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "png-to-ico": "^3.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
